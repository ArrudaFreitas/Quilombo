# ─────────────────────────────────────────────────────────────────────────────
# Quilombo Backend — variáveis de ambiente
# Copie este arquivo para .env.homolog ou .env.prod e preencha os valores reais.
# NUNCA commit arquivos .env.* com valores reais.
# ─────────────────────────────────────────────────────────────────────────────

# ── Perfil ativo ─────────────────────────────────────────────────────────────
# Valores possíveis: dev | homolog | prod
SPRING_PROFILES_ACTIVE=dev

# ── Servidor ─────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ── Banco de dados ────────────────────────────────────────────────────────────
# Dev usa fallback local (quilombo_dev). Homolog e Prod EXIGEM estas variáveis.
DATABASE_URL=jdbc:postgresql://localhost:5432/quilombo
DB_USERNAME=quilombo
DB_PASSWORD=quilombo

# ── JWT ───────────────────────────────────────────────────────────────────────
# Mínimo 256 bits (32 caracteres) para HMAC-SHA256.
# Dev usa fallback "dev-only-secret..." — não usar em produção.
JWT_SECRET=troque-por-uma-chave-segura-com-no-minimo-32-caracteres
JWT_EXPIRATION_HOURS=24

# ── Google OAuth2 ─────────────────────────────────────────────────────────────
# Credenciais do projeto no Google Cloud Console.
# Dev pode usar "placeholder" (mock). Homolog e Prod precisam de valores reais.
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-seu-client-secret

# ── Homolog: Basic Auth ───────────────────────────────────────────────────────
# Apenas no perfil homolog. Define as credenciais do portão de entrada.
HOMOLOG_USER=dev
HOMOLOG_PASSWORD=troque-por-senha-forte

# ── Domínio base ──────────────────────────────────────────────────────────────
# Dev: quilombo.localhost | Homolog: homolog.quilombo.com.br | Prod: quilombo.com.br
APP_BASE_DOMAIN=quilombo.localhost
