# URL interna do backend — usada apenas no servidor Next.js, nunca exposta ao browser.
# Via Docker (padrão): http://backend:8080
# Sem Docker (dev local direto): https://quilombo.localhost:8080
API_URL=http://backend:8080

# Domínio base da aplicação multi-tenant.
NEXT_PUBLIC_BASE_DOMAIN=quilombo.localhost

# As imagens são servidas same-origin pelo nginx em /quilombo-uploads/ (proxy para o MinIO),
# então o frontend não precisa conhecer a URL do storage.
