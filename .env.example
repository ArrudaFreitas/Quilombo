# ── Variáveis de DEV (carregadas automaticamente pelo docker-compose) ──────────
# Copie para .env (gitignored) e aponte DEV_ADMIN_EMAIL para a SUA conta Google.
# Um único client-id alimenta o backend (audiência do idToken) e o front (botão GIS).

# Client ID do OAuth do Google (tipo "Aplicativo da Web"). NÃO é segredo e pode ser
# compartilhado: o login verifica o idToken apenas com as chaves PÚBLICAS do Google —
# não existe client secret neste fluxo. As Authorized JavaScript origins do domínio de
# dev (quilombo.ianarruda.dev:8080 e os subdomínios das comunidades) já estão
# registradas neste client-id. Para isolar, crie o seu e troque aqui.
GOOGLE_CLIENT_ID=466476952455-1884rnisml94uvi5k1r1ugvef9kcqb63.apps.googleusercontent.com

# Conta Google com que VOCÊ vai logar. O seed a registra como admin das comunidades
# de dev (kalunga/palmares/frechal). Com a tela de consentimento publicada, qualquer
# conta Google funciona — basta apontar a sua aqui.
DEV_ADMIN_EMAIL=
